{
    "name": "andmarruda/lpb",
    "description": "Page builder backend for Laravel: a validated, versioned page tree in SQL or MongoDB, 48 built-in widgets, atomic saves, publishing with rollback, a cache that never goes stale, media on local/S3/R2 or the database, and delivery to React, Vue, Svelte or Angular via Inertia, Blade or a headless API.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Andmarruda\\Lpb\\": "src/app/"
        }
    },
    "authors": [
        {
            "name": "Anderson Arruda",
            "email": "anderson@sysborg.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "laravel/framework": ">=10.0",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "mongodb/laravel-mongodb": "Required when using MongoDB as the database driver (^5.0)"
    },
    "autoload-dev": {
        "psr-4": {
            "Andmarruda\\Lpb\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.sql.xml --testsuite=Unit",
        "test:unit": "vendor/bin/phpunit -c phpunit.sql.xml --testsuite=Unit",
        "test:coverage": "vendor/bin/phpunit -c phpunit.sql.xml --testsuite=Unit --coverage-html coverage",
        "test:sqlite": "shell/test-sql.sh",
        "test:mysql": "shell/test-mysql.sh",
        "test:mongo": "shell/test-mongo.sh",
        "test:all": "shell/test-all.sh"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andmarruda\\Lpb\\Providers\\DatabaseAbstractionServiceProvider"
            ],
            "aliases": {
                "Lpb": "Andmarruda\\Lpb\\Facades\\Lpb"
            }
        }
    },
    "keywords": [
        "laravel",
        "page-builder",
        "cms",
        "mongodb",
        "inertia",
        "headless",
        "widgets",
        "react",
        "vue",
        "svelte",
        "angular"
    ]
}
